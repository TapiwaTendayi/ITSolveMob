# ============================================================
# ITSolve Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Node environment — set to "production" on your server
NODE_ENV=production

# Port the backend listens on (nginx proxies to this)
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/ITSolve
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ITSolve?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ITSolve

# JWT secret — MUST be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
